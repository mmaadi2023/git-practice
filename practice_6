def count_comparables(listings):
    
    by_suburb = {}

    for i, listing in enumerate(listings):
        suburb = listing ['suburb']
        by_suburb.setdefault(suburb,[]).append((i,listing["price"]))

        results = [0] * len (listings)

        for suburb,group in by_suburb.items():
                for i, price_i in group:
                     
                     count = 0
                     for j, price_j in group:
                          
                          if i!=j and abs(price_i - price_j) <+50000:
                               count +=1

                     results[i] = count
                     
    return results    
                


listings = [
    {"suburb": "Richmond", "price": 800000},
    {"suburb": "Richmond", "price": 820000},
    {"suburb": "Richmond", "price": 1000000},
    {"suburb": "Fitzroy", "price": 900000},
]


print (count_comparables(listings))